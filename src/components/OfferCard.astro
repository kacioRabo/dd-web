---
import { withBase } from '../lib/site';

interface Props {
  href: string;
  title: string;
  image: string;
}

const { href, title, image } = Astro.props;
---

<a class="offer-card" href={withBase(href)}>
  <img src={withBase(image)} alt={title} width="640" height="420" loading="lazy" />
  <span>{title}</span>
</a>
