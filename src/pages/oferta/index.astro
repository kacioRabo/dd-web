---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import OfferCard from '../../components/OfferCard.astro';

const page = await getEntry('pages', 'oferta');
if (!page) throw new Error('Brak treści oferty');
const { Content } = await render(page);
const items = (await getCollection('oferta')).sort((a, b) => a.data.order - b.data.order);
---

<Base
  title={page.data.title}
  seoTitle={page.data.seoTitle}
  description={page.data.description}
  breadcrumbs={[
    { name: 'Strona główna', href: '/' },
    { name: 'Oferta', href: '/oferta/' },
  ]}
>
  <section class="page-hero">
    <div class="wrap">
      <h1>{page.data.title}</h1>
    </div>
  </section>
  <section class="section" style="padding-top: 0;">
    <div class="wrap">
      <div class="prose">
        <Content />
      </div>
      <div class="grid offer-grid" style="margin-top: 1.5rem;">
        {
          items.map((item) => (
            <OfferCard href={`/${item.id}/`} title={item.data.cardTitle} image={item.data.image} />
          ))
        }
      </div>
    </div>
  </section>
</Base>
