---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SocialFeeds from '../../components/SocialFeeds.astro';

const posts = (await getCollection('aktualnosci')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base
  title="Aktualności"
  seoTitle="Aktualności | Realizacje nagłośnienia i oświetlenia | Dobry Dźwięk"
  description="Realizacje Dobrego Dźwięku — nagłośnienie, oświetlenie i obsługa techniczna eventów w Poznaniu. Newsy z Facebooka i Instagrama."
  breadcrumbs={[
    { name: 'Strona główna', href: '/' },
    { name: 'Aktualności', href: '/aktualnosci/' },
  ]}
>
  <section class="page-hero">
    <div class="wrap">
      <h1>Aktualności</h1>
    </div>
  </section>
  <section class="section" style="padding-top: 0;">
    <div class="wrap">
      <p>Najnowsze posty z Facebooka i Instagrama Dobrego Dźwięku.</p>
      <SocialFeeds />
      {
        posts.length > 0 && (
          <>
            <h2 class="fb-archive-title">Z archiwum</h2>
            <div class="grid news-grid">
              {posts.map((item) => (
                <a class="news-card" href={`/aktualnosci/${item.id}/`}>
                  {item.data.image && <img src={item.data.image} alt={item.data.title} width="640" height="320" loading="lazy" />}
                  <div>
                    <time datetime={item.data.date.toISOString()}>{item.data.date.toLocaleDateString('pl-PL')}</time>
                    <h3>{item.data.title}</h3>
                    <p>{item.data.excerpt}</p>
                  </div>
                </a>
              ))}
            </div>
          </>
        )
      }
    </div>
  </section>
</Base>
